  "combination_strategy": {
    "T1": {
      "method": "穷举 + 边界值",
      "rationale": "T1 全部为本地 HTTP/WS 调用，单例耗时 <200ms，可以穷举；角色×人群×情感交叉 6×4×5=120 也全部真跑",
      "cross_dimensions": ["role", "population", "emotion"]
    },
    "T2": {
      "method": "贪心 pairwise + 分层补充 3 轮用例",
      "rationale": "真实对话每轮含 LLM(+TTS) 网络耗时，全量笛卡尔积 9×4×5=180 无法在 90 分钟内跑完；pairwise 保证任意两维取值组合至少出现一次，规模约 45 条；另取约 1/8 用例扩展为 3 轮验证上下文保持",
      "max_estimated_seconds": 2400
    },
    "T3": {
      "method": "只探测不硬跑",
      "rationale": "本地无 GPU；CPU TTS RTF 35-88，单句需数分钟；声音定义/克隆依赖 VoxCPM2（cloud 模式不可用），硬跑会耗尽时间预算"
    }
  },
  "t3_probes": [
    {"id": "T3-P01", "name": "本机 GPU 可用性", "kind": "gpu"},
    {"id": "T3-P02", "name": "本地 VoxCPM2 模型与 CUDA 依赖", "kind": "local_model"},
    {"id": "T3-P03", "name": "云 TTS 合成（qwen3-tts-flash）", "kind": "cloud_tts"},
    {"id": "T3-P04", "name": "ASR paraformer-realtime-v2 转写", "kind": "asr"},
    {"id": "T3-P05", "name": "声音定义 voice design（/api/voice/define）", "kind": "voice_define"},
    {"id": "T3-P06", "name": "声音克隆端点", "kind": "voice_clone"},
    {"id": "T3-P07", "name": "情感音色效果（情感参数驱动 TTS）", "kind": "emotion_tts"},
    {"id": "T3-P08", "name": "语音回放/播放链路", "kind": "playback"}
  ]
