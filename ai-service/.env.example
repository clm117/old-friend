# ============================================================
# 语伴 AI 服务本地裸跑配置模板
# 用法：复制为 .env 后按实际填写（真实 .env 已被 .gitignore 排除）
# 严禁将真实密钥提交到代码库
#
# 容器化部署（docker compose）时不需要本文件——所有变量从根 .env 注入，
# 网关与 AI 服务通过 compose 的 ${AI_INTERNAL_TOKEN:-${JWT_SECRET}} 共享同一密钥。
# ============================================================

# ===== 网关 → AI 服务内部身份签名密钥（必填，否则所有网关转发接口 401「缺少可信用户身份」）=====
# 网关用该密钥对 "账号|时间戳" 做 HMAC-SHA256，AI 服务只认签名以防止直连伪造 X-Yuban-User。
# 必须与网关侧（根 .env 的 AI_INTERNAL_TOKEN 或 JWT_SECRET）完全一致。
# 典型值：openssl rand -hex 32 生成的 64 字符十六进制串
AI_INTERNAL_TOKEN=change-me-to-same-as-gateway-secret

# ===== 对话模型 =====
# glm（智谱免费）| qwen（阿里 DashScope 按需计费）| deepseek
LLM_PROVIDER=glm
# 模型对应供应商：glm-4-flash / qwen-plus / deepseek-chat
LLM_MODEL=glm-4-flash
# 对应供应商控制台获取的 API Key
LLM_API_KEY=

# ===== TTS 提供方 =====
# cloud（阿里 DashScope 云 TTS，需账户余额）| edge（edge-tts 免费日常合成）| voxcpm2（本地模型需 GPU）
TTS_PROVIDER=cloud

# 云 TTS 专用（TTS_PROVIDER=cloud 时必填）—— 与 LLM_API_KEY 相互独立
CLOUD_TTS_MODEL=qwen3-tts-flash
CLOUD_TTS_VOICE=Cherry
DASHSCOPE_API_KEY=

# edge-tts 音色（TTS_PROVIDER=edge 时生效）
EDGE_TTS_VOICE=zh-CN-XiaoxiaoNeural

# ===== 声音克隆（edge 模式下的可选增强）=====
# volc（火山引擎声音复刻2.0，国内直连，默认）| fish（Fish Audio，当前国内网络不可用）
VOICE_CLONE_PROVIDER=volc

# --- 火山引擎控制台获取（https://console.volcengine.com/speech/）---
VOLC_TTS_APPID=
VOLC_TTS_ACCESS_TOKEN=
VOLC_TTS_SPEAKER_ID=               # 音色库中创建的音色，形如 S_xxxxxxx
VOLC_TTS_RESOURCE_ID=seed-icl-2.0  # 复刻2.0；复刻1.0 改为 seed-icl-1.0
VOLC_TTS_CLUSTER=volcano_icl

# --- Fish Audio（备用，当前网络 DNS 污染不可达）---
FISH_AUDIO_API_KEY=
