# ============================================================
# 语伴 生产环境变量模板
# 用法：复制为 .env 后按实际填写（.env 已在 .gitignore/.dockerignore 中排除）
# 严禁将真实密钥提交到代码库
# ============================================================

# --- LLM / ASR（阿里云 DashScope 通义千问；ASR 复用同一个 Key）---
LLM_PROVIDER=qwen
LLM_API_KEY=
LLM_MODEL=qwen-plus

# --- API 网关：鉴权 ---
# 生产务必改为足够长的随机串，例如：openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
# 是否强制所有 /api、/ws 请求携带有效 JWT（生产必须为 true）
# 置 true 前需先播种账号（见下方 AUTH_USERS_FILE），且 JWT_SECRET 不能留空，否则网关拒绝启动
AUTH_REQUIRED=true
# 签发令牌的有效期（分钟，默认 720 = 12 小时）
AUTH_TOKEN_TTL_MINUTES=720
# 登录接口专用限流（次/分钟/IP，防口令爆破与账号枚举）
LOGIN_RATE_LIMIT_PER_MINUTE=5
# 账号表路径：compose 中挂载 ./authdata:/app/authdata，账号由 auth_seed.py 离线创建
AUTH_USERS_FILE=/app/authdata/users.json

# --- API 网关：账号表播种 ---
# 账号由 auth_seed.py 离线写入 authdata/users.json（本文件不存放任何明文口令）。
# 首次部署：在项目根目录先播种账号，再启动服务（新增账号后需重启网关生效）
#   Linux/macOS : AUTH_USERS_FILE=./authdata/users.json python api-gateway/auth_seed.py add <账号>
#   PowerShell  : $env:AUTH_USERS_FILE="./authdata/users.json"; python api-gateway/auth_seed.py add <账号>

# --- API 网关：CORS 白名单（逗号分隔，禁止使用 *）---
CORS_ALLOW_ORIGINS=http://localhost:8080,https://yuban.moonexplore.cn

# --- API 网关：限流（次/分钟，按客户端 IP 分桶）---
RATE_LIMIT_PER_MINUTE=120
EXPENSIVE_RATE_LIMIT_PER_MINUTE=20

# --- 上传与请求限制 ---
MAX_UPLOAD_MB=10
AI_SERVICE_TIMEOUT=60
AI_SERVICE_TTS_TIMEOUT=600

# --- 是否开放 /docs 与 /openapi.json（生产建议 false）---
ENABLE_DOCS=false

# --- nginx 对外端口（宿主机映射端口）---
NGINX_HTTP_PORT=8080

# --- AI 服务基础镜像（可选覆盖）---
# 默认对齐开发环境 torch/CUDA；若服务器驱动较旧，可换用 CUDA 12 系列镜像
# AI_BASE_IMAGE=pytorch/pytorch:2.5.1-cuda12.1-cudnn9-runtime

# --- TTS 提供方 ---
# voxcpm2：本地模型，实时交互需要 GPU（CPU RTF 很高，不建议生产使用）
# cloud：云 TTS，验证期使用，声音定义/克隆等本地能力不可用
TTS_PROVIDER=voxcpm2

# --- 容器首次启动账号初始化（compose 的 auth-init 使用）---
# 仅当账号表中不存在该账号时创建，不会覆盖已有口令；口令只写 .env，勿提交
AUTH_SEED_USER=admin
AUTH_SEED_PASSWORD=

# --- 状态持久化（会话 / 对话历史 / 情感配置 / 语音绑定）---
# 本地落盘目录与文件（compose 中分别是 /app/data 与 /app/data/state.json）
YUBAN_DATA_DIR=./ai-service/data
YUBAN_STATE_FILE=./ai-service/data/state.json
# 可选：配置 Redis 后状态双写、限流跨实例共享（需 docker compose --profile redis up -d）
REDIS_URL=
GATEWAY_REDIS_URL=

# --- 可观测性（compose 内 Prometheus / Alertmanager / Grafana，仅绑定 127.0.0.1）---
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
# 生产务必修改
GRAFANA_ADMIN_PASSWORD=change-me-before-prod

# --- 备份脚本（infrastructure/backup/）---
BACKUP_DIR=./backups
BACKUP_KEEP=7

